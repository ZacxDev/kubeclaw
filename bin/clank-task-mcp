#!/usr/bin/env python3
"""
clank-task-mcp — MCP stdio server wrapping the clank-resolver Task HTTP API.

Stdlib-only. Runs inside every OpenClaw agent devpod as a registered MCP server.
Reads auth and routing from env vars CLANK_TASK_API_TOKEN / CLANK_TASK_API_URL /
CLANK_AGENT_ID.

Protocol: JSON-RPC 2.0 over stdio (newline-delimited JSON).
Stdout is the MCP channel — all diagnostics go to stderr.
"""

import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

DEFAULT_URL = "http://clank-resolver-api.clank-resolver.svc.cluster.local:18800"
USER_AGENT = "ClankTaskMCP/1.0"

SERVER_INFO = {
    "name": "clank-task",
    "version": "1.0.0",
}

CAPABILITIES = {
    "tools": {},
}

# ---------------------------------------------------------------------------
# HTTP helpers (mirrors clank-task CLI)
# ---------------------------------------------------------------------------


class ApiError(Exception):
    def __init__(self, status, body, parsed=None):
        self.status = status
        self.body = body
        self.parsed = parsed
        super().__init__(f"HTTP {status}: {body}")


class NetworkError(Exception):
    pass


def _request(method, base_url, path, token, body=None, query=None):
    url = base_url.rstrip("/") + path
    if query:
        clean = {k: v for k, v in query.items() if v is not None}
        if clean:
            url = url + "?" + urllib.parse.urlencode(clean)

    data = None
    headers = {
        "User-Agent": USER_AGENT,
        "Accept": "application/json",
    }
    if token:
        headers["Authorization"] = "Bearer " + token
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"

    req = urllib.request.Request(url, data=data, headers=headers, method=method)

    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            raw = resp.read().decode("utf-8", errors="replace")
            try:
                return json.loads(raw) if raw else {}
            except json.JSONDecodeError:
                return {"_raw": raw}
    except urllib.error.HTTPError as e:
        raw = ""
        try:
            raw = e.read().decode("utf-8", errors="replace")
        except Exception:
            pass
        parsed = None
        try:
            parsed = json.loads(raw) if raw else None
        except json.JSONDecodeError:
            parsed = None
        raise ApiError(e.code, raw, parsed)
    except urllib.error.URLError as e:
        raise NetworkError(f"network error: {e.reason}")
    except (TimeoutError, OSError) as e:
        raise NetworkError(f"transport error: {e}")


def _unwrap(resp, key):
    if isinstance(resp, dict) and key in resp:
        return resp[key]
    return resp


# ---------------------------------------------------------------------------
# Environment
# ---------------------------------------------------------------------------

def _env():
    return {
        "url": os.environ.get("CLANK_TASK_API_URL", DEFAULT_URL),
        "token": os.environ.get("CLANK_TASK_API_TOKEN", ""),
        "agent_id": os.environ.get("CLANK_AGENT_ID", ""),
    }


# ---------------------------------------------------------------------------
# Tool definitions
# ---------------------------------------------------------------------------

TOOLS = [
    {
        "name": "task_show",
        "description": "Show details for a single task by ID.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "id": {"type": "string", "description": "Task ID"},
            },
            "required": ["id"],
        },
    },
    {
        "name": "task_list",
        "description": "List tasks, optionally filtered by status and/or assignee agent.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "status": {"type": "string", "description": "Filter by status (created, assigned, in_progress, blocked, review, completed, cancelled, failed)"},
                "agent": {"type": "string", "description": "Filter by assignee agent ID"},
            },
        },
    },
    {
        "name": "task_my_tasks",
        "description": "List active tasks assigned to this agent (uses CLANK_AGENT_ID).",
        "inputSchema": {
            "type": "object",
            "properties": {
                "include_completed": {"type": "boolean", "description": "Include completed tasks"},
                "limit": {"type": "integer", "description": "Maximum results to return"},
            },
        },
    },
    {
        "name": "task_search",
        "description": "Full-text search across all tasks.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "query": {"type": "string", "description": "Search query text"},
            },
            "required": ["query"],
        },
    },
    {
        "name": "task_accept",
        "description": "Claim/accept a task as the current agent. Sets status to assigned.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "id": {"type": "string", "description": "Task ID to accept"},
                "version": {"type": "integer", "description": "Optimistic concurrency version (optional)"},
            },
            "required": ["id"],
        },
    },
    {
        "name": "task_progress",
        "description": "Append a progress note to a task.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "id": {"type": "string", "description": "Task ID"},
                "note": {"type": "string", "description": "Progress note text"},
                "version": {"type": "integer", "description": "Optimistic concurrency version (optional)"},
            },
            "required": ["id", "note"],
        },
    },
    {
        "name": "task_complete",
        "description": "Mark a task as completed with an optional summary.",
        "inputSchema": {
            "type": "object",
            "properties": {
                "id": {"type": "string", "description": "Task ID"},
                "summary": {"type": "string", "description": "Completion summary (optional)"},
