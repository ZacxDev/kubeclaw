                "assign": {"type": "string", "description": "Assignee agent ID (optional)"},
                "priority": {"type": "string", "description": "Priority: low, normal, high, critical"},
                "instructions": {"type": "string", "description": "Task instructions / body text"},
            },
            "required": ["title"],
        },
    },
]


# ---------------------------------------------------------------------------
# Tool handlers
# ---------------------------------------------------------------------------

def handle_task_show(params, env):
    task_id = params["id"]
    resp = _request("GET", env["url"], f"/api/tasks/{task_id}", env["token"])
    return json.dumps(_unwrap(resp, "task"), indent=2)


def handle_task_list(params, env):
    query = {}
    if params.get("status"):
        query["status"] = params["status"]
    if params.get("agent"):
        query["assignee"] = params["agent"]
    resp = _request("GET", env["url"], "/api/tasks", env["token"], query=query)
    tasks = _unwrap(resp, "tasks") or []
    return json.dumps(tasks, indent=2)


def handle_task_my_tasks(params, env):
    agent_id = env["agent_id"]
    if not agent_id:
        raise ValueError("CLANK_AGENT_ID not set — cannot determine which agent's tasks to show")
    query = {"agentId": agent_id}
    if params.get("include_completed"):
        query["includeCompleted"] = "true"
    if params.get("limit"):
        query["limit"] = str(params["limit"])
    resp = _request("GET", env["url"], "/api/my-tasks", env["token"], query=query)
    tasks = _unwrap(resp, "tasks") or []
    return json.dumps(tasks, indent=2)


def handle_task_search(params, env):
    resp = _request("GET", env["url"], "/api/tasks/search", env["token"],
                     query={"q": params["query"]})
    tasks = _unwrap(resp, "tasks") or []
    return json.dumps(tasks, indent=2)


def handle_task_accept(params, env):
    body = {}
    if params.get("version") is not None:
        body["version"] = params["version"]
    if env["agent_id"]:
        body["agentId"] = env["agent_id"]
    resp = _request("POST", env["url"], f"/api/tasks/{params['id']}/accept",
                     env["token"], body=body)
    task = _unwrap(resp, "task")
    return f"Accepted task {params['id']}\n\n{json.dumps(task, indent=2)}"


def handle_task_progress(params, env):
    body = {"note": params["note"]}
    if params.get("version") is not None:
        body["version"] = params["version"]
    resp = _request("POST", env["url"], f"/api/tasks/{params['id']}/progress",
                     env["token"], body=body)
    task = _unwrap(resp, "task")
    version_info = f" (version {task.get('version')})" if task and task.get("version") else ""
    return f"Progress appended to {params['id']}{version_info}: {params['note']}"


def handle_task_complete(params, env):
    body = {}
    if params.get("summary"):
        body["summary"] = params["summary"]
    if params.get("version") is not None:
        body["version"] = params["version"]
    resp = _request("POST", env["url"], f"/api/tasks/{params['id']}/complete",
                     env["token"], body=body)
    task = _unwrap(resp, "task")
    return f"Completed task {params['id']}\n\n{json.dumps(task, indent=2)}"


def handle_task_blocked(params, env):
    body = {"reason": params["reason"]}
    if params.get("version") is not None:
        body["version"] = params["version"]
    resp = _request("POST", env["url"], f"/api/tasks/{params['id']}/blocked",
                     env["token"], body=body)
    task = _unwrap(resp, "task")
    return f"Task {params['id']} marked blocked: {params['reason']}\n\n{json.dumps(task, indent=2)}"


def handle_task_create(params, env):
    body = {"title": params["title"]}
    if params.get("assign"):
        body["assigneeAgentId"] = params["assign"]
    if params.get("priority"):
        body["priority"] = params["priority"]
    if params.get("instructions"):
        body["instructions"] = params["instructions"]
    resp = _request("POST", env["url"], "/api/tasks", env["token"], body=body)
    task = _unwrap(resp, "task") or {}
    return f"Created task {task.get('id', '?')}: {params['title']}\n\n{json.dumps(task, indent=2)}"


HANDLERS = {
    "task_show": handle_task_show,
    "task_list": handle_task_list,
    "task_my_tasks": handle_task_my_tasks,
    "task_search": handle_task_search,
    "task_accept": handle_task_accept,
    "task_progress": handle_task_progress,
    "task_complete": handle_task_complete,
    "task_blocked": handle_task_blocked,
    "task_create": handle_task_create,
}


# ---------------------------------------------------------------------------
# JSON-RPC / MCP protocol
# ---------------------------------------------------------------------------

def _ok(req_id, result):
    return {"jsonrpc": "2.0", "id": req_id, "result": result}


def _error(req_id, code, message):
    return {"jsonrpc": "2.0", "id": req_id, "error": {"code": code, "message": message}}


def _tool_result(text, is_error=False):
    result = {"content": [{"type": "text", "text": text}]}
    if is_error:
        result["isError"] = True
    return result


def handle_request(msg):
    req_id = msg.get("id")
    method = msg.get("method", "")
    params = msg.get("params", {})

    if method == "initialize":
        return _ok(req_id, {
            "protocolVersion": "2024-11-05",
            "serverInfo": SERVER_INFO,
            "capabilities": CAPABILITIES,
        })

    if method == "notifications/initialized":
        # Client acknowledgement — no response needed
        return None

    if method == "tools/list":
        return _ok(req_id, {"tools": TOOLS})

    if method == "tools/call":
        tool_name = params.get("name", "")
        tool_params = params.get("arguments", {})
        handler = HANDLERS.get(tool_name)

        if not handler:
            return _ok(req_id, _tool_result(f"Unknown tool: {tool_name}", is_error=True))

        env = _env()
        if not env["token"]:
            return _ok(req_id, _tool_result(
                "CLANK_TASK_API_TOKEN not set", is_error=True))

        try:
            result_text = handler(tool_params, env)
            return _ok(req_id, _tool_result(result_text))
        except ApiError as e:
            parsed = e.parsed if isinstance(e.parsed, dict) else None
            if parsed and parsed.get("error") == "version_conflict":
                current = parsed.get("current", {})
                msg_text = f"Version conflict — task was updated elsewhere. Current version: {current.get('version', '?')}\n\n{json.dumps(current, indent=2)}"
                return _ok(req_id, _tool_result(msg_text, is_error=True))
            detail = json.dumps(parsed, indent=2) if parsed else e.body
            return _ok(req_id, _tool_result(
                f"API error (HTTP {e.status}): {detail}", is_error=True))
        except NetworkError as e:
            return _ok(req_id, _tool_result(f"Network error: {e}", is_error=True))
        except (KeyError, ValueError, TypeError) as e:
            return _ok(req_id, _tool_result(f"Invalid parameters: {e}", is_error=True))

    # Unknown method
    return _error(req_id, -32601, f"Method not found: {method}")


def main():
    print(f"clank-task-mcp: starting (api={os.environ.get('CLANK_TASK_API_URL', DEFAULT_URL)})",
          file=sys.stderr)

    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue

        try:
            msg = json.loads(line)
        except json.JSONDecodeError as e:
            resp = _error(None, -32700, f"Parse error: {e}")
            sys.stdout.write(json.dumps(resp) + "\n")
            sys.stdout.flush()
            continue

        resp = handle_request(msg)
        if resp is not None:
            sys.stdout.write(json.dumps(resp) + "\n")
            sys.stdout.flush()


if __name__ == "__main__":
    main()
